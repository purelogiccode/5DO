<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Desktop UI -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Host services -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="XenoAtom.ShaderCompiler.Build" Version="1.2.2" />
    <PackageVersion Include="CHDSharp" Version="1.6.3" />
    <!-- Cover packager (build-time tool) -->
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.155.0" />
    <!-- Tests and benchmarks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>