<Project>

  <!--
    Silk.NET.OpenAL loads "OpenAL32" on Windows, while the OpenAL Soft native package
    ships soft_oal.dll. Copy the Windows runtime under the loader's expected name for
    the audio library, the two executables, and the test host. Linux and macOS use the
    package's libopenal.so/libopenal.dylib names without a rename.

    This is an explicit copy target instead of a Content item because Directory.Build.targets
    is imported after the SDK's copy-item target has been defined.
  -->
  <PropertyGroup>
    <_FiveDoOpenAlRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_FiveDoOpenAlRid>
    <_FiveDoOpenAlRid Condition="'$(_FiveDoOpenAlRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_FiveDoOpenAlRid>
    <_FiveDoNeedsOpenAlNative
      Condition="'$(MSBuildProjectName)' == 'FiveDo.Audio'
                 or '$(MSBuildProjectName)' == 'FiveDo.Cli'
                 or '$(MSBuildProjectName)' == 'FiveDo.Frontend.Avalonia'
                 or '$(MSBuildProjectName)' == 'FiveDo.Tests'">true</_FiveDoNeedsOpenAlNative>
    <_FiveDoOpenAlSoftSource>$(NuGetPackageRoot)silk.net.openal.soft.native/$(FiveDoOpenAlSoftVersion)/runtimes/$(_FiveDoOpenAlRid)/native/soft_oal.dll</_FiveDoOpenAlSoftSource>
    <_FiveDoNeedsOpenAlWindowsNative
      Condition="'$(_FiveDoNeedsOpenAlNative)' == 'true' and ('$(_FiveDoOpenAlRid)' == 'win-x64' or '$(_FiveDoOpenAlRid)' == 'win-arm64' or '$(_FiveDoOpenAlRid)' == 'win-x86')">true</_FiveDoNeedsOpenAlWindowsNative>
  </PropertyGroup>

  <Target Name="FiveDoCopyOpenAlSoft" AfterTargets="Build" Condition="'$(_FiveDoNeedsOpenAlWindowsNative)' == 'true'">
    <Copy SourceFiles="$(_FiveDoOpenAlSoftSource)"
          DestinationFiles="$(TargetDir)OpenAL32.dll"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="FiveDoPublishOpenAlSoft" AfterTargets="Publish" Condition="'$(_FiveDoNeedsOpenAlWindowsNative)' == 'true'">
    <!--
      Publish must use the loader name, not the NuGet package name. Using
      DestinationFolder here copies soft_oal.dll again and leaves Silk.NET searching
      for a system OpenAL32.dll, which can exist but fail to create a context.
      CopyToPublishDirectory on the Content item does not rename the file either.
    -->
    <Copy SourceFiles="$(_FiveDoOpenAlSoftSource)"
          DestinationFiles="$(PublishDir)OpenAL32.dll"
          SkipUnchangedFiles="true" />
    <!-- Keep the package-name copy too. Single-file publish may embed or drop the
         runtime asset, and the licence notice documents both files beside the apps. -->
    <Copy SourceFiles="$(_FiveDoOpenAlSoftSource)"
          DestinationFiles="$(PublishDir)soft_oal.dll"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    XenoAtom.ShaderCompiler.Build ships its dotnet-shaderc tool with a net8.0
    runtimeconfig. A machine with only the .NET 9/10/11 runtimes therefore fails the
    Vulkan shader step with "You must install or update .NET" even though the SDK is
    installed. Set the runtime roll-forward for this build process so the tool runs on
    the newest installed runtime; when .NET 8 is present, Major still prefers it.

    The environment variable is inherited by the ShaderCompileTask's child process.
  -->
  <UsingTask
    TaskName="FiveDoSetEnvironmentVariable"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Name ParameterType="System.String" Required="true" />
      <Value ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.Environment.SetEnvironmentVariable(Name, Value);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FiveDoAllowShaderCompilerRollForward"
          BeforeTargets="ShaderCompile"
          Condition="'$(MSBuildProjectName)' == 'FiveDo.Video.Vulkan'">
    <FiveDoSetEnvironmentVariable Name="DOTNET_ROLL_FORWARD" Value="Major" />
  </Target>

</Project>
