<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ThreeDo.Frontend.Avalonia</RootNamespace>
    <AssemblyName>ThreeDo.Frontend.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Opt-in NativeAOT folder publish: -p:ThreeDoNativeAot=true.
         Single-file AOT is blocked by Silk.NET.Core's native-asset loader
         (Assembly.Location/CodeBase and DependencyContext), so AOT uses the
         folder publish layout. The default six-RID publish remains trimmed IL. -->
    <PublishAot Condition="'$(ThreeDoNativeAot)' == 'true'">true</PublishAot>
    <PublishSingleFile Condition="'$(ThreeDoNativeAot)' == 'true'">false</PublishSingleFile>
    <!-- Silk.NET.Core's native-asset loader still uses Assembly.Location and
         DependencyContext, which the AOT analyzer flags as single-file hazards.
         Folder AOT is validated (smoke test and WGL probe); keep the warnings
         visible in the publish log without failing the opt-in build. -->
    <IlcTreatWarningsAsErrors Condition="'$(ThreeDoNativeAot)' == 'true'">false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!--
      CHDSharp's VendoredFlac settings helper uses TypeDescriptor. The frontend reads
      only the first data track through CHDSharp and does not decode CD-DA/FLAC audio,
      so keep the remaining third-party warning visible but non-fatal (same policy as
      the trimmed CLI).
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThreeDo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreeDo.Host\ThreeDo.Host.csproj" />
    <ProjectReference Include="..\ThreeDo.Video.OpenGL\ThreeDo.Video.OpenGL.csproj" />
  </ItemGroup>

</Project>
