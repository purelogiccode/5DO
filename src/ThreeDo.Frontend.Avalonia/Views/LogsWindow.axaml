<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThreeDo.Frontend.Avalonia.Views.LogsWindow"
        Title="Diagnostic Log"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LevelCombo" Grid.Column="1" Width="120" Margin="0,0,12,0"
                      SelectionChanged="OnFilterChanged" />
            <TextBlock Grid.Column="2" Text="Category" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="CategoryCombo" Grid.Column="3" Width="150"
                      Margin="0,0,12,0" SelectionChanged="OnFilterChanged" />
            <TextBox x:Name="SearchBox" Grid.Column="4" Margin="0,0,12,0"
                     PlaceholderText="Search messages" TextChanged="OnSearchChanged" />
            <CheckBox x:Name="AutoRefreshCheck" Grid.Column="5" Content="Auto refresh"
                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="6" Content="Refresh" Click="OnRefresh" Margin="0,0,6,0" />
            <Button Grid.Column="7" Content="Clear" Click="OnClear" />
        </Grid>

        <ListBox x:Name="LogList" Grid.Row="1" FontFamily="Consolas,monospace" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Opacity="0.8" />
            <Button Grid.Column="1" Content="Close" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
