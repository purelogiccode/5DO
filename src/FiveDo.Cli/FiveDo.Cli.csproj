<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FiveDo.Cli</RootNamespace>
    <AssemblyName>FiveDo.Cli</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Opt-in NativeAOT publish: -p:FiveDoNativeAot=true. The default CI
         publish remains trimmed IL so all six RIDs can be produced on one OS. -->
    <PublishAot Condition="'$(FiveDoNativeAot)' == 'true'">true</PublishAot>
    <!-- Silk.NET.Core's native-asset loader flags IL3000/IL3002 for single-file.
         The loader falls back to AppContext.BaseDirectory, where the OpenAL Soft
         runtime is copied; keep the warnings visible without failing the build. -->
    <IlcTreatWarningsAsErrors Condition="'$(FiveDoNativeAot)' == 'true'">false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!--
      CHDSharp's VendoredFlac settings helper uses TypeDescriptor. The CHD data-track
      path does not call it, and every first-party trim warning has been fixed, so keep
      the remaining third-party warning visible but non-fatal.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="VideoGameFileSystemParser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiveDo.Host\FiveDo.Host.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FiveDoOpenAlNativeRid)' == 'win-x64' or '$(FiveDoOpenAlNativeRid)' == 'win-arm64' or '$(FiveDoOpenAlNativeRid)' == 'win-x86'">
    <Content Include="$(NuGetPackageRoot)silk.net.openal.soft.native/$(FiveDoOpenAlSoftVersion)/runtimes/$(FiveDoOpenAlNativeRid)/native/soft_oal.dll"
             Link="OpenAL32.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

</Project>
