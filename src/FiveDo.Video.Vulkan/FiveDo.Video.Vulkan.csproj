<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FiveDo.Video.Vulkan</RootNamespace>
    <AssemblyName>FiveDo.Video.Vulkan</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ShaderCompilerGlobalOption_class_name>VulkanShaders</ShaderCompilerGlobalOption_class_name>
    <NoWarn>$(NoWarn);MA0048</NoWarn>
    <LangVersion>15</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="XenoAtom.ShaderCompiler.Build">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveDo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiveDo.Core\FiveDo.Core.csproj" />
    <ProjectReference Include="..\FiveDo.Video\FiveDo.Video.csproj" />
  </ItemGroup>

</Project>
