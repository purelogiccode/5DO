<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FiveDo.Frontend.Avalonia</RootNamespace>
    <AssemblyName>FiveDo.Frontend.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon2.ico</ApplicationIcon>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Opt-in NativeAOT publish: -p:FiveDoNativeAot=true.
         Single-file AOT is validated; Silk.NET.Core's native-asset loader still
         uses Assembly.Location/CodeBase and DependencyContext, so the AOT analyzer
         warnings are kept visible but non-fatal. The default six-RID publish
         remains trimmed IL. -->
    <PublishAot Condition="'$(FiveDoNativeAot)' == 'true'">true</PublishAot>
    <PublishSingleFile Condition="'$(FiveDoNativeAot)' == 'true'">true</PublishSingleFile>
    <!-- Silk.NET.Core's native-asset loader flags IL3000/IL3002 for single-file.
         The AOT GL/WGL/ANGLE and smoke paths are validated; keep the warnings
         visible without failing the opt-in build. Audio under single-file AOT is
         not yet validated. -->
    <IlcTreatWarningsAsErrors Condition="'$(FiveDoNativeAot)' == 'true'">false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!--
      CHDSharp's VendoredFlac settings helper uses TypeDescriptor. The frontend reads
      only the first data track through CHDSharp and does not decode CD-DA/FLAC audio,
      so keep the remaining third-party warning visible but non-fatal (same policy as
      the trimmed CLI).
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveDo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiveDo.Host\FiveDo.Host.csproj" />
    <ProjectReference Include="..\FiveDo.Tas\FiveDo.Tas.csproj" />
    <ProjectReference Include="..\FiveDo.Video.OpenGL\FiveDo.Video.OpenGL.csproj" />
    <ProjectReference Include="..\FiveDo.Video.Vulkan\FiveDo.Video.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FiveDoOpenAlNativeRid)' == 'win-x64' or '$(FiveDoOpenAlNativeRid)' == 'win-arm64' or '$(FiveDoOpenAlNativeRid)' == 'win-x86'">
    <Content Include="$(NuGetPackageRoot)silk.net.openal.soft.native/$(FiveDoOpenAlSoftVersion)/runtimes/$(FiveDoOpenAlNativeRid)/native/soft_oal.dll"
             Link="OpenAL32.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

</Project>
