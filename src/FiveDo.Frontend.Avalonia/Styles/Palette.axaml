<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RPCS3-inspired dark palette. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#17181B" />
    <SolidColorBrush x:Key="MenuBarBrush" Color="#1B1D20" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#202226" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2024" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#25282D" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#181A1D" />
    <SolidColorBrush x:Key="FieldBrush" Color="#141518" />
    <SolidColorBrush x:Key="CardBrush" Color="#23262B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2C3036" />
    <SolidColorBrush x:Key="PressedBrush" Color="#22252A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#32353B" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3E4249" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA0A8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#6E747D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3DAEE9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5BBFF0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2A8FC2" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#263F52" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#3DAEE9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#57C878" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E0B050" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E06C6C" />

    <!-- Keep the Fluent theme's accent in step with the RPCS3 blue. -->
    <Color x:Key="SystemAccentColor">#3DAEE9</Color>
    <Color x:Key="SystemAccentColorLight1">#5BBFF0</Color>
    <Color x:Key="SystemAccentColorLight2">#7ACCF5</Color>
    <Color x:Key="SystemAccentColorLight3">#A3DDFA</Color>
    <Color x:Key="SystemAccentColorDark1">#2A8FC2</Color>
    <Color x:Key="SystemAccentColorDark2">#1F749F</Color>
    <Color x:Key="SystemAccentColorDark3">#155A7D</Color>

    <x:Double x:Key="LibraryCardWidth">176</x:Double>
    <x:Double x:Key="LibraryCardImageHeight">176</x:Double>

