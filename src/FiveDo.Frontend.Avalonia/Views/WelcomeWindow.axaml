<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FiveDo.Frontend.Avalonia.Views.WelcomeWindow"
        Title="Welcome to 5DO"
        Width="560" Height="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel x:Name="ContentPanel" Grid.Row="0" Spacing="12">
                <TextBlock x:Name="HeaderText" Text="Welcome to 5DO" FontSize="22" FontWeight="SemiBold"
                           ToolTip.Tip="First-run setup guide for the emulator." />
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" Opacity="0.9"
                           Text="This is a pure C# 3DO emulator. To start, choose a legally obtained BIOS ROM and a disc image. The application does not include BIOS files or games."
                           ToolTip.Tip="5DO does not ship BIOS ROMs or game images; you must provide your own." />
                <TextBlock x:Name="DiscHelpText" TextWrapping="Wrap" Opacity="0.75"
                           Text="Supported discs: ISO, BIN, CUE+BIN, and CHD. You can change these paths later in Settings."
                           ToolTip.Tip="Supported disc containers. Paths can be changed later in Settings." />
                <Border Background="#202020" CornerRadius="3" Padding="10"
                        ToolTip.Tip="Three steps to start a game.">
                    <StackPanel Spacing="4">
                        <TextBlock Text="First steps" FontWeight="SemiBold"
                                   ToolTip.Tip="Quick-start checklist." />
                        <TextBlock x:Name="Step1Text" Text="1. Open a 3DO BIOS (panafz1.bin or another compatible 1 MB ROM)." Opacity="0.85"
                                   ToolTip.Tip="Load a 1 MB 3DO BIOS ROM, such as panafz1.bin." />
                        <TextBlock x:Name="Step2Text" Text="2. Open a disc image." Opacity="0.85"
                                   ToolTip.Tip="Choose an ISO, BIN, CUE, or CHD image." />
                        <TextBlock x:Name="Step3Text" Text="3. Press Play, then use the keyboard or a gamepad." Opacity="0.85"
                                   ToolTip.Tip="Start emulation and use the configured input bindings." />
                    </StackPanel>
                </Border>

                <Border x:Name="DiscoveredBiosPanel" IsVisible="False"
                        Background="#17301D" CornerRadius="3" Padding="10"
                        ToolTip.Tip="A BIOS image was found in a standard folder.">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DiscoveredBiosText" TextWrapping="Wrap" Opacity="0.9" />
                        <Button x:Name="UseDiscoveredBiosButton" Content="Use this BIOS" Click="OnUseDiscoveredBios"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Load the discovered BIOS and continue." />
                    </StackPanel>
                </Border>

                <Border x:Name="BiosFolderPanel" IsVisible="False"
                        Background="#202020" CornerRadius="3" Padding="10"
                        ToolTip.Tip="Folder scanned for 1 MB BIOS images and optional BIOS2/Kanji fonts.">
                    <StackPanel Spacing="6">
                        <TextBlock Text="BIOS folder" FontWeight="SemiBold"
                                   ToolTip.Tip="Folder scanned for 1 MB BIOS images and optional BIOS2/Kanji fonts." />
                        <TextBlock x:Name="BiosFolderText" TextWrapping="Wrap" Opacity="0.8"
                                   ToolTip.Tip="Folder scanned for 1 MB BIOS images and optional BIOS2/Kanji fonts." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ScanButton" Content="Scan" Click="OnScan"
                                    ToolTip.Tip="Re-scan the BIOS folder for a usable BIOS." />
                            <Button x:Name="OpenBiosFolderButton" Content="Open Folder" Click="OnOpenBiosFolder"
                                    ToolTip.Tip="Open the BIOS folder in the file manager." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,18,0,0">
            <TextBlock Grid.Column="0" Text="Choose Continue to set up later from the toolbar."
                       VerticalAlignment="Center" Opacity="0.6" FontSize="11"
                       ToolTip.Tip="You can open the BIOS and disc later from the toolbar or File menu." />
            <Button x:Name="ContinueButton" Grid.Column="1" Content="Continue" Click="OnContinue" Margin="0,0,8,0"
                    ToolTip.Tip="Close the guide without loading a BIOS or disc." />
            <Button x:Name="OpenBiosButton" Grid.Column="2" Content="Open BIOS" Click="OnOpenBios" Margin="0,0,8,0"
                    ToolTip.Tip="Choose a 3DO BIOS ROM." />
            <Button x:Name="OpenDiscButton" Grid.Column="3" Content="Open Disc" Click="OnOpenDisc"
                    ToolTip.Tip="Choose a disc image to boot." />
        </Grid>
    </Grid>
</Window>
