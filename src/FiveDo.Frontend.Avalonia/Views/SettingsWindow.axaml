<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FiveDo.Frontend.Avalonia.Views.SettingsWindow"
        Title="Settings"
        Width="680" Height="640"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <TabControl Grid.Row="0" ToolTip.Tip="Video, audio, emulation, and path settings.">
            <TabItem Header="Video" ToolTip.Tip="Renderer, output resolution, filter, aspect ratio, scaling, overlay, OSD notifications, quick menu, bloom, and FSR options.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="170,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          Margin="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Renderer"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Graphics API" VerticalAlignment="Center"
                                   ToolTip.Tip="Choose the presentation backend." />
                        <ComboBox x:Name="RendererCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                  ToolTip.Tip="OpenGL is the fastest path. Vulkan renders offscreen with CPU readback. Software uses the CPU renderer." />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="OpenGL is recommended. Vulkan is optional and presents through a CPU readback. Software is the compatibility fallback."
                                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   ToolTip.Tip="Renderer notes. Changing the backend recreates the current presenter without restarting emulation." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="Display"
                                   FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Output resolution" VerticalAlignment="Center"
                                   ToolTip.Tip="Choose the size of the filtered output image." />
                        <ComboBox x:Name="ResolutionCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                  ToolTip.Tip="Match the window, use a native multiple, or upscale to 720p, 1080p, 1440p, or 4K." />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="Match window follows the window size. Fixed resolutions render at that size and scale to fit the window; they do not change internal CEL resolution."
                                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   ToolTip.Tip="Output upscaling only; the emulated frame remains at its native resolution." />

                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="Filtering"
                                   FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Filter" VerticalAlignment="Center"
                                   ToolTip.Tip="Choose the output filter applied by the presenter." />
                        <ComboBox x:Name="FilterCombo" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                                  ToolTip.Tip="Nearest, sharp-bilinear, CRT, xBR, HQx, or AMD FSR 1.0." />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Aspect" VerticalAlignment="Center"
                                   ToolTip.Tip="Choose how the 4:3 source is fitted to the output." />
                        <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <ComboBox x:Name="AspectCombo" Grid.Column="0"
                                      ToolTip.Tip="Integer, 4:3, stretch, or custom." />
                            <TextBox x:Name="CustomAspectBox" Grid.Column="1" Width="72" Margin="6,0,0,0"
                                     ToolTip.Tip="Custom width/height ratio, for example 1.333 or 1.6." />
                        </Grid>
                        <CheckBox x:Name="IntegerCheck" Grid.Row="9" Grid.Column="1" Content="Integer scaling"
                                  ToolTip.Tip="Restrict scaling to whole-number multiples for uniform pixels." />
                        <CheckBox x:Name="VsyncCheck" Grid.Row="10" Grid.Column="1" Content="VSync (where supported)"
                                  ToolTip.Tip="Request vertical sync from the platform where the backend supports it." />
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Frame skip" VerticalAlignment="Center"
                                   ToolTip.Tip="Skip presentation frames when the emulator falls behind. Emulation and audio keep full speed." />
                        <ComboBox x:Name="FrameSkipCombo" Grid.Row="11" Grid.Column="1" Margin="0,0,0,4"
                                  ToolTip.Tip="Auto is recommended. Fixed modes present one of every 2-5 frames; emulation still runs every frame." />
                        <TextBlock Grid.Row="12" Grid.Column="1"
                                   Text="Auto only drops presentation frames when the loop misses its deadline. The game still runs at full speed, so input, audio, and save states are unchanged."
                                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   ToolTip.Tip="Frame skipping is presentation-only." />
                        <CheckBox x:Name="OverlayCheck" Grid.Row="13" Grid.Column="1" Content="Show FPS/status overlay"
                                  ToolTip.Tip="Show frame rate, renderer timing, and audio queue counters over the game." />
                        <CheckBox x:Name="NativeScreenshotCheck" Grid.Row="14" Grid.Column="1"
                                  Content="Also save the native CPU frame with screenshots"
                                  ToolTip.Tip="Write a second, unfiltered PNG of the native CPU frame beside the filtered capture." />
                        <TextBlock Grid.Row="15" Grid.Column="0" Text="CRT bloom" VerticalAlignment="Center"
                                   ToolTip.Tip="Adjust the glow around bright areas in the CRT filter." />
                        <Slider x:Name="BloomSlider" Grid.Row="15" Grid.Column="1"
                                Minimum="0" Maximum="1" TickFrequency="0.05"
                                ToolTip.Tip="CRT bloom strength from 0 (off) to 1 (strongest)." />
                        <TextBlock Grid.Row="16" Grid.Column="0" Text="FSR sharpness" VerticalAlignment="Center"
                                   ToolTip.Tip="Adjust RCAS sharpening when the FSR filter is selected." />
                        <Slider x:Name="FsrSharpnessSlider" Grid.Row="16" Grid.Column="1"
                                Minimum="0" Maximum="1" TickFrequency="0.05"
                                ToolTip.Tip="FSR RCAS sharpness from 0 (soft) to 1 (maximum)." />
                        <TextBlock Grid.Row="17" Grid.Column="1"
                                   Text="xBR runs an edge-directed 4x pass; HQx runs a 2x/3x/4x CPU pixel-art pass; FSR runs AMD FidelityFX Super Resolution 1.0 (EASU + RCAS) at the output. CRT bloom adds a glow around bright areas. All of them cost more CPU/GPU time at 4K; HQx 3x/4x are the most expensive."
                                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   ToolTip.Tip="Filter notes: xBR and HQx are CPU-heavy; FSR and CRT bloom run on the GPU." />

                        <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Text="On-screen display"
                                   FontWeight="SemiBold" Margin="0,12,0,4" />
                        <CheckBox x:Name="OsdCheck" Grid.Row="19" Grid.Column="1"
                                  Content="Show OSD notifications"
                                  ToolTip.Tip="Show save, load, rewind, fast-forward, screenshot, and reset confirmations over the game." />
                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Notification position"
                                   VerticalAlignment="Center" ToolTip.Tip="Choose where notifications appear over the game." />
                        <ComboBox x:Name="OsdPositionCombo" Grid.Row="20" Grid.Column="1" Margin="0,0,0,4"
                                  ToolTip.Tip="Top or bottom, left, center, or right." />
                        <TextBlock Grid.Row="21" Grid.Column="0" Text="Notification opacity"
                                   VerticalAlignment="Center" ToolTip.Tip="Fade notifications so they do not cover the game." />
                        <Slider x:Name="OsdOpacitySlider" Grid.Row="21" Grid.Column="1"
                                Minimum="0.1" Maximum="1" TickFrequency="0.05"
                                ToolTip.Tip="Notification opacity from 0.1 (nearly transparent) to 1 (opaque)." />
                        <TextBlock Grid.Row="22" Grid.Column="0" Text="Notification duration (ms)"
                                   VerticalAlignment="Center" ToolTip.Tip="How long each notification stays visible." />
                        <TextBox x:Name="OsdDurationBox" Grid.Row="22" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left"
                                 ToolTip.Tip="500-10000 milliseconds." />
                        <CheckBox x:Name="QuickMenuCheck" Grid.Row="23" Grid.Column="1"
                                  Content="Enable the in-game quick menu (F4 or Select+Start)"
                                  ToolTip.Tip="Open a keyboard/gamepad quick menu for save, load, rewind, fast-forward, screenshot, reset, cheats, and settings." />
                        <TextBlock Grid.Row="24" Grid.Column="1"
                                   Text="Notifications confirm save/load, rewind, fast-forward, screenshots, resets, and settings changes. The quick menu pauses the game while it is open and resumes when it closes."
                                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   ToolTip.Tip="OSD and quick-menu behaviour." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio" ToolTip.Tip="OpenAL output, volume, CD-DA mix, and test-tone settings.">
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output" VerticalAlignment="Center"
                               ToolTip.Tip="Enable or disable live OpenAL playback." />
                    <CheckBox x:Name="AudioCheck" Grid.Row="0" Grid.Column="1" Content="Enable OpenAL output"
                              ToolTip.Tip="Play the emulated DSP through the bundled OpenAL Soft runtime." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume" VerticalAlignment="Center"
                               ToolTip.Tip="Set the live output volume." />
                    <Slider x:Name="VolumeSlider" Grid.Row="1" Grid.Column="1"
                            Minimum="0" Maximum="1" TickFrequency="0.05"
                            ToolTip.Tip="Output volume from 0 (muted) to 1 (full)." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CD-DA volume" VerticalAlignment="Center"
                               ToolTip.Tip="Set the Red Book CD audio mix level." />
                    <Slider x:Name="CdVolumeSlider" Grid.Row="2" Grid.Column="1"
                             Minimum="0" Maximum="1" TickFrequency="0.05"
                             ToolTip.Tip="CD-DA mix level from 0 (silent) to 1 (full)." />
                    <CheckBox x:Name="CdMuteCheck" Grid.Row="3" Grid.Column="1" Content="Mute CD-DA"
                               ToolTip.Tip="Keep CD-DA playback running without mixing it into the output." />
                    <CheckBox x:Name="AutoSwapCheck" Grid.Row="4" Grid.Column="1"
                              Content="Insert the next playlist disc when a game ejects"
                              ToolTip.Tip="ODE-style automatic disc advance after a guest eject. When no playlist is loaded, use F3 to insert a disc." />
                    <Button x:Name="TestAudioButton" Grid.Row="5" Grid.Column="1"
                            Content="Play 440 Hz test tone" Click="OnTestAudioClickAsync"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            ToolTip.Tip="Play a one-second 440 Hz tone to verify the output device." />
                    <TextBlock x:Name="TestAudioText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="OpenAL Soft 1.23.1 · 44.1 kHz stereo"
                               Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               ToolTip.Tip="Audio backend status and test-tone result." />
                </Grid>
            </TabItem>

            <TabItem Header="Emulation" ToolTip.Tip="Per-game fixes, ARM, CLIO, CEL, and CD timing, CD speed, CPU clock, random seed, NVRAM storage, high-resolution mode, rewind/fast-forward, and overrides.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8">
                    <CheckBox x:Name="AutoFixesCheck" Grid.Row="0" Grid.Column="1"
                              Content="Apply the 4DO per-game fixes automatically"
                              ToolTip.Tip="Apply the compatibility fix mask from the built-in game database when a disc opens." />
                    <CheckBox x:Name="HighResCheck" Grid.Row="1" Grid.Column="1"
                              Content="High-resolution CEL mode (640x480, opt-in)"
                              ToolTip.Tip="Render CELs and bitmap lines at 640x480. Only enable for titles that support it." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ARM timing" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Select the ARM60 N-cycle length used by the interpreter." />
                    <ComboBox x:Name="ArmTimingCombo" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="FreeDO-compatible uses N=4. ARM60 datasheet uses N=2 and changes instruction timing; save states record the mode." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CLIO timers" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Select how the CLIO timer slots are scanned." />
                    <ComboBox x:Name="ClioTimersCombo" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="FreeDO services all timers per event. Opera walks one timer slot at a time with an explicit cascade carry; save states record the mode." />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CEL timing" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Select how the MADAM CEL engine consumes emulated time." />
                    <ComboBox x:Name="CelTimingCombo" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="FreeDO draws synchronously. Opera defers the draw and keeps CEL status busy until the estimated pixel/texel deadline; save states record the mode." />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="CD timing" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Select how the CD-ROM drive schedules data sectors." />
                    <ComboBox x:Name="CdromTimingCombo" Grid.Row="5" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="FreeDO transfers sectors immediately. Opera schedules each sector at the stock 2x drive speed and reports the drive busy while it is not ready; save states record the mode." />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="CPU clock" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="ARM60 clock multiplier. 1.0 is the stock 12.5 MHz; 0.5x-4x is supported." />
                    <TextBox x:Name="CpuClockBox" Grid.Row="6" Grid.Column="1" Margin="0,12,0,0"
                             PlaceholderText="1.0 (stock 12.5 MHz; range 0.5-4.0)"
                             ToolTip.Tip="Enter a multiplier between 0.5 and 4.0. Higher clocks can change timing-sensitive behavior." />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Random seed" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Initial DSP PRNG seed. Leave blank for the FreeDO default, or enter a 32-bit value." />
                    <TextBox x:Name="RandomSeedBox" Grid.Row="7" Grid.Column="1" Margin="0,12,0,0"
                             PlaceholderText="Default (blank) or a 32-bit seed such as 0x1234"
                             ToolTip.Tip="A fixed seed makes fresh runs reproducible. The seed is part of save-state data once the DSP advances." />
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Current game" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="The disc whose per-game overrides are being edited." />
                    <TextBlock x:Name="GameText" Grid.Row="8" Grid.Column="1" Text="No disc loaded."
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               ToolTip.Tip="The currently loaded game and its database entry." />
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Fix-mode override" VerticalAlignment="Center"
                               ToolTip.Tip="Override the automatic 4DO compatibility fix mask." />
                    <TextBox x:Name="FixModeBox" Grid.Row="9" Grid.Column="1"
                             PlaceholderText="Automatic (hexadecimal mask, for example 0x20)"
                             ToolTip.Tip="Enter a hexadecimal fix mask, or leave blank to use the database value." />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Leave blank to use the database value."
                               Opacity="0.7" FontSize="11"
                               ToolTip.Tip="A blank override keeps the automatic per-game fix mask." />
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Filter override" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Override the output filter for this game." />
                    <ComboBox x:Name="FilterOverrideCombo" Grid.Row="11" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="Automatic or a per-game filter override." />
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="CD speed" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Effective read speed for the cycle-based CD model." />
                    <ComboBox x:Name="CdSpeedCombo" Grid.Row="12" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="Stock is 2x. Unbounded removes the host-side sector delay; speeds above 16x can expose timing issues." />
                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Timing profile" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Apply a named bundle of timing options." />
                    <ComboBox x:Name="ProfileCombo" Grid.Row="13" Grid.Column="1" Margin="0,12,0,0"
                              SelectionChanged="OnProfileChanged"
                              ToolTip.Tip="Compatible keeps FreeDO timing. Accuracy enables ARM60, Opera timers, CEL busy timing, and cycle-based CD reads. Performance uses a 1.5x CPU clock with FreeDO timing. Custom keeps the current options." />
                    <TextBlock Grid.Row="14" Grid.Column="0" Text="BIOS override" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Override automatic BIOS selection for the current game." />
                    <ComboBox x:Name="BiosOverrideCombo" Grid.Row="14" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="Automatic uses the region-appropriate BIOS from the BIOS folder. A specific image pins this game to that BIOS MD5." />
                    <TextBlock Grid.Row="15" Grid.Column="0" Text="NVRAM storage" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Choose one shared NVRAM image or a separate image for every game." />
                    <ComboBox x:Name="NvramStorageCombo" Grid.Row="15" Grid.Column="1" Margin="0,12,0,0"
                              ToolTip.Tip="Per-game keeps each title's save data isolated. Switching from shared copies the shared image on the first save." />
                    <TextBlock Grid.Row="16" Grid.Column="0" Text="NVRAM version" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Independent NVRAM version slot, 0-9." />
                    <TextBox x:Name="NvramVersionBox" Grid.Row="16" Grid.Column="1" Margin="0,12,0,0"
                             PlaceholderText="0"
                             ToolTip.Tip="Versions 0-9 are separate images. Changing the version does not overwrite another version." />
                    <CheckBox x:Name="RewindCheck" Grid.Row="17" Grid.Column="1" Margin="0,12,0,0"
                              Content="Enable rewind history"
                              ToolTip.Tip="Keep compressed keyframes and input so the emulated machine can be rewound." />
                    <TextBlock Grid.Row="18" Grid.Column="0" Text="Rewind history" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Rewind window in seconds. Longer windows use more memory." />
                    <TextBox x:Name="RewindSecondsBox" Grid.Row="18" Grid.Column="1" Margin="0,12,0,0"
                             PlaceholderText="60 (30-300 seconds)"
                             ToolTip.Tip="History length in seconds. The default is 60 seconds." />
                    <TextBlock Grid.Row="19" Grid.Column="0" Text="Fast-forward speed" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Multiplier used while the fast-forward hotkey is held." />
                    <TextBox x:Name="FastForwardBox" Grid.Row="19" Grid.Column="1" Margin="0,12,0,0"
                             PlaceholderText="4 (2-10x)"
                             ToolTip.Tip="Run 2x-10x emulated frames per presentation tick. Audio is muted while fast-forwarding." />
                    <TextBlock Grid.Row="20" Grid.Column="0" Text="Input devices 1-3" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Choose the PBUS device on ports 1-3." />
                    <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                        <ComboBox x:Name="InputDevice1Combo" Width="132"
                                  ToolTip.Tip="Port 1 device. A joypad is the default; mouse, lightgun, arcade lightgun, flightstick, and Orbatak trackball are available." />
                        <ComboBox x:Name="InputDevice2Combo" Width="132"
                                  ToolTip.Tip="Port 2 device." />
                        <ComboBox x:Name="InputDevice3Combo" Width="132"
                                  ToolTip.Tip="Port 3 device." />
                    </StackPanel>
                    <TextBlock Grid.Row="21" Grid.Column="0" Text="Input devices 4-6" VerticalAlignment="Center" Margin="0,12,0,0"
                               ToolTip.Tip="Choose the PBUS device on ports 4-6." />
                    <StackPanel Grid.Row="21" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                        <ComboBox x:Name="InputDevice4Combo" Width="132"
                                  ToolTip.Tip="Port 4 device." />
                        <ComboBox x:Name="InputDevice5Combo" Width="132"
                                  ToolTip.Tip="Port 5 device." />
                        <ComboBox x:Name="InputDevice6Combo" Width="132"
                                  ToolTip.Tip="Port 6 device." />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Paths" ToolTip.Tip="Save-state, screenshot, cover-art, cheat, BIOS, and library-metadata settings.">
                <Grid ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Save states" VerticalAlignment="Center"
                               ToolTip.Tip="Folder used for numbered save slots and thumbnails." />
                    <TextBox x:Name="SaveDirectoryBox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,8"
                             ToolTip.Tip="Path to the save-state folder." />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="OnBrowseSaveDirectoryAsync" Margin="0,0,0,8"
                            ToolTip.Tip="Choose the save-state folder." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Screenshots" VerticalAlignment="Center"
                               ToolTip.Tip="Folder used for PNG screenshots." />
                    <TextBox x:Name="ScreenshotDirectoryBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,8"
                             ToolTip.Tip="Path to the screenshot folder." />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="OnBrowseScreenshotDirectoryAsync" Margin="0,0,0,8"
                            ToolTip.Tip="Choose the screenshot folder." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Game covers" VerticalAlignment="Center"
                               ToolTip.Tip="Folder containing cover images named after the disc files." />
                    <TextBox x:Name="CoverDirectoryBox" Grid.Row="2" Grid.Column="1" Margin="0,0,6,0"
                             ToolTip.Tip="Cover images use the disc filename with an image extension, for example Battle Chess (Europe).png." />
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse" Click="OnBrowseCoverDirectoryAsync"
                            ToolTip.Tip="Choose the folder containing game cover images." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS folder" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Folder scanned for 1 MB BIOS images and optional BIOS2/Kanji fonts." />
                    <TextBox x:Name="BiosFolderBox" Grid.Row="3" Grid.Column="1" Margin="0,8,6,0"
                             ToolTip.Tip="Folder containing BIOS files. Auto-select scans this folder for a region-appropriate image." />
                    <Button Grid.Row="3" Grid.Column="2" Content="Browse" Click="OnBrowseBiosFolderAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Choose the BIOS folder." />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Auto-select BIOS" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Pick a region-appropriate BIOS for each disc." />
                    <CheckBox x:Name="AutoBiosCheck" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                              Content="Choose the best BIOS for each disc (region, Kanji, arcade)"
                              ToolTip.Tip="Uses the disc's game database region and known title requirements. The configured BIOS remains the fallback." />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="BIOS1" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Fallback primary BIOS image." />
                    <TextBox x:Name="BiosPathBox" Grid.Row="5" Grid.Column="1" Margin="0,8,6,0"
                             ToolTip.Tip="Path to the 1 MB primary BIOS used when auto-selection is off or unavailable." />
                    <Button Grid.Row="5" Grid.Column="2" Content="Browse" Click="OnBrowseBiosPathAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Choose the primary BIOS file." />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="BIOS2 / font" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Optional BIOS2 or Kanji font ROM." />
                    <TextBox x:Name="Bios2PathBox" Grid.Row="6" Grid.Column="1" Margin="0,8,6,0"
                             ToolTip.Tip="Optional secondary ROM, such as a Kanji font, loaded into ROM bank 2." />
                    <Button Grid.Row="6" Grid.Column="2" Content="Browse" Click="OnBrowseBios2PathAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Choose the optional BIOS2/font file." />
                    <Button x:Name="ScanBiosButton" Grid.Row="7" Grid.Column="0" Content="Scan BIOS folder"
                            Click="OnScanBiosAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Validate every BIOS file in the folder and show the recognized profiles." />
                    <TextBlock x:Name="BiosScanText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                               ToolTip.Tip="BIOS scan result." />
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Cheats" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Folder containing per-game cheat JSON files." />
                    <TextBox x:Name="CheatsDirectoryBox" Grid.Row="8" Grid.Column="1" Margin="0,8,6,0"
                             ToolTip.Tip="Per-game cheat files use the 4DO game ID as the file name." />
                    <Button Grid.Row="8" Grid.Column="2" Content="Browse" Click="OnBrowseCheatsDirectoryAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Choose the cheat folder." />
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Library metadata" VerticalAlignment="Center" Margin="0,8,0,0"
                               ToolTip.Tip="Optional offline JSON metadata for titles, developers, genres, and descriptions." />
                    <TextBox x:Name="LibraryMetadataPathBox" Grid.Row="9" Grid.Column="1" Margin="0,8,6,0"
                             ToolTip.Tip="Leave empty to use library-metadata.json in the 5DO settings folder." />
                    <Button Grid.Row="9" Grid.Column="2" Content="Browse" Click="OnBrowseLibraryMetadataAsync" Margin="0,8,0,0"
                            ToolTip.Tip="Choose a library-metadata.json file." />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#FF8080" TextWrapping="Wrap"
                       ToolTip.Tip="Validation messages for the current settings." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="OK" Click="OnOk" IsDefault="True"
                        ToolTip.Tip="Validate and apply these settings." />
                <Button Content="Cancel" Click="OnCancel" IsCancel="True"
                        ToolTip.Tip="Discard changes and close this dialog." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
