<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FiveDo.Frontend.Avalonia.Views"
        x:Class="FiveDo.Frontend.Avalonia.Views.InputTimelineWindow"
        Title="Input Timeline"
        Width="1100" Height="700"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" x:Name="PathText" VerticalAlignment="Center"
                       Text="No movie loaded." TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="Open a .5domovie file to view and edit its player-1 input timeline." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Content="Open Movie..." Click="OnOpenClick"
                        ToolTip.Tip="Load a 5DO TAS movie." />
                <Button x:Name="SaveTimelineButton" Content="Save Timeline..." Click="OnSaveTimelineClick"
                        IsEnabled="False"
                        ToolTip.Tip="Save the timeline as an editable frame/buttons script." />
                <Button x:Name="ApplyMovieButton" Content="Apply to Movie..." Click="OnApplyMovieClick"
                        IsEnabled="False"
                        ToolTip.Tip="Write the edited timeline back into a copy of the movie." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="12">
            <Border Grid.Column="0" BorderBrush="#2A3138" BorderThickness="1" CornerRadius="4"
                    ClipToBounds="True"
                    ToolTip.Tip="One row per 3DO pad button. Click a column to select a frame.">
                <local:TimelineStrip x:Name="Strip" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Player 1 buttons" FontWeight="SemiBold"
                           ToolTip.Tip="Toggle the 3DO pad buttons held on the selected frame." />
                <WrapPanel ItemWidth="96" ItemHeight="28">
                    <CheckBox x:Name="AButton" Content="A" Tag="A" ToolTip.Tip="3DO pad A button." />
                    <CheckBox x:Name="BButton" Content="B" Tag="B" ToolTip.Tip="3DO pad B button." />
                    <CheckBox x:Name="CButton" Content="C" Tag="C" ToolTip.Tip="3DO pad C button." />
                    <CheckBox x:Name="PButton" Content="P" Tag="P" ToolTip.Tip="3DO pad P (play/pause) button." />
                    <CheckBox x:Name="XButton" Content="X" Tag="X" ToolTip.Tip="3DO pad X (stop) button." />
                    <CheckBox x:Name="LButton" Content="L" Tag="L" ToolTip.Tip="Left shoulder button." />
                    <CheckBox x:Name="RButton" Content="R" Tag="R" ToolTip.Tip="Right shoulder button." />
                    <CheckBox x:Name="UpButton" Content="Up" Tag="Up" ToolTip.Tip="D-pad up." />
                    <CheckBox x:Name="DownButton" Content="Down" Tag="Down" ToolTip.Tip="D-pad down." />
                    <CheckBox x:Name="LeftButton" Content="Left" Tag="Left" ToolTip.Tip="D-pad left." />
                    <CheckBox x:Name="RightButton" Content="Right" Tag="Right" ToolTip.Tip="D-pad right." />
                </WrapPanel>
                <Button x:Name="ApplyButton" Content="Apply to selected frame" Click="OnApplyClick"
                        IsEnabled="False" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Replace player 1's buttons on the selected frame." />
                <Separator />
                <TextBlock Text="Legend" FontWeight="SemiBold" />
                <TextBlock Text="Each colored row is a held button. The white line is the selected frame."
                           TextWrapping="Wrap" Opacity="0.75" FontSize="11" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,12,0,0" RowSpacing="6">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Frame" VerticalAlignment="Center" />
                <Slider Grid.Column="1" x:Name="FrameSlider" Minimum="0" Maximum="1"
                        ValueChanged="OnFrameChanged" IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        ToolTip.Tip="Select a frame to inspect or edit." />
                <TextBlock Grid.Column="2" x:Name="FrameText" Text="0" VerticalAlignment="Center"
                           FontFamily="Consolas" MinWidth="96" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center"
                           Opacity="0.8" TextWrapping="Wrap"
                           ToolTip.Tip="Timeline length and edit status." />
                <Button Grid.Column="1" Content="Close" Click="OnCloseClick"
                        ToolTip.Tip="Close the input timeline." />
            </Grid>
        </Grid>
    </Grid>
</Window>
