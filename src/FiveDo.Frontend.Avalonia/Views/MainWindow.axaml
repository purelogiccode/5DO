<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FiveDo.Frontend.Avalonia.ViewModels"
        xmlns:ctrl="using:FiveDo.Frontend.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="FiveDo.Frontend.Avalonia.Views.MainWindow"
        Icon="/Assets/fivedo.ico"
        Width="1060" Height="620"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="5DO">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Menu bar -->
        <Menu Grid.Row="0" x:Name="MainMenu" ToolTip.Tip="Open discs, control emulation, configure the app, and view logs.">
            <MenuItem Header="File" ToolTip.Tip="Open a BIOS or disc, add game folders, boot recent discs, or exit.">
                <MenuItem Header="Open BIOS..." Click="OnOpenBiosAsync"
                          ToolTip.Tip="Choose a 3DO BIOS ROM (for example panafz1.bin)." />
                <MenuItem Header="Assign BIOS to Current Game..." Click="OnAssignBiosToGameAsync"
                          ToolTip.Tip="Pin the current game to a specific BIOS MD5. Restart the game to apply it." />
                <MenuItem Header="Clear Game BIOS Assignment" Click="OnClearBiosAssignment"
                          ToolTip.Tip="Return the current game to automatic BIOS selection." />
                <MenuItem Header="Export NVRAM..." Click="OnExportNvramAsync"
                          ToolTip.Tip="Write the current game's 32 KB NVRAM image to a file." />
                <MenuItem Header="Import NVRAM..." Click="OnImportNvramAsync"
                          ToolTip.Tip="Replace the current game's NVRAM with a 32 KB image." />
                <MenuItem Header="Reset NVRAM" Click="OnResetNvram"
                          ToolTip.Tip="Clear the current game's NVRAM back to a fresh volume." />
                <MenuItem Header="Boot Disc..." Click="OnOpenDiscAsync"
                          ToolTip.Tip="Choose an ISO, BIN, CUE, or CHD disc image and boot it." />
                <MenuItem Header="Add Game Folder..." Click="OnAddFolderAsync"
                          ToolTip.Tip="Add a folder that the library scans for disc images." />
                <MenuItem x:Name="RecentMenu" Header="Boot Recent"
                          ToolTip.Tip="Boot a disc that was opened recently." />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit"
                          ToolTip.Tip="Close 5DO and return to the desktop." />
            </MenuItem>

            <MenuItem Header="Emulation" ToolTip.Tip="Start, pause, reset, save/load, record input, capture screenshots, and toggle fullscreen.">
                <MenuItem x:Name="PlayPauseMenuItem" Header="Start" Click="OnPlayPause"
                          ToolTip.Tip="Start or pause the emulated console." />
                <MenuItem x:Name="StopMenuItem" Header="Stop" Click="OnStop"
                          ToolTip.Tip="Stop emulation and return to the game list." />
                <MenuItem Header="Reset" Click="OnReset"
                          ToolTip.Tip="Reset the emulated console and reload the current disc." />
                <MenuItem Header="Rewind 1 Second" Click="OnRewind"
                          ToolTip.Tip="Restore the machine one second back using the rewind history." />
                <MenuItem Header="Rewind 1 Frame" Click="OnRewindFrame"
                          ToolTip.Tip="Restore the machine one frame back using the rewind history." />
                <MenuItem x:Name="FastForwardMenuItem" Header="Fast-Forward" ToggleType="CheckBox"
                          Click="OnFastForward"
                          ToolTip.Tip="Run at the configured 2x-10x speed until toggled off or Tab is released." />
                <Separator />
                <MenuItem Header="Save State" Click="OnSaveState"
                          ToolTip.Tip="Save the current state to the selected slot." />
                <MenuItem Header="Load State" Click="OnLoadState"
                          ToolTip.Tip="Load the selected save slot." />
                <MenuItem Header="Previous Slot" Click="OnPreviousSlot"
                          ToolTip.Tip="Select the previous save slot." />
                <MenuItem Header="Next Slot" Click="OnNextSlot"
                          ToolTip.Tip="Select the next save slot." />
                <MenuItem Header="Save Slots..." Click="OnSaveSlotsAsync"
                          ToolTip.Tip="Open the save-slot manager with previews." />
                <MenuItem Header="Cheats..." Click="OnCheatsAsync"
                          ToolTip.Tip="Enable, add, or edit per-game RAM cheats." />
                <Separator />
                <MenuItem Header="Screenshot" Click="OnScreenshot"
                          ToolTip.Tip="Save a PNG screenshot of the current frame." />
                <MenuItem x:Name="RecordInputMenuItem" Header="Record Input" ToggleType="CheckBox"
                          Click="OnRecordInput"
                          ToolTip.Tip="Record player-1 input to a replay script that the CLI can run with --input-script." />
                <Separator />
                <MenuItem Header="Fullscreen" Click="OnFullscreen"
                          ToolTip.Tip="Toggle fullscreen presentation." />
            </MenuItem>

            <MenuItem Header="Configuration" ToolTip.Tip="Video, audio, emulation, path, and input settings.">
                <MenuItem Header="Settings..." Click="OnSettingsAsync"
                          ToolTip.Tip="Open video, audio, emulation, and path settings." />
                <MenuItem Header="Input Bindings..." Click="OnInputBindingsAsync"
                          ToolTip.Tip="Configure keyboard and gamepad bindings for all six players." />
                <Separator />
                <MenuItem x:Name="HighResMenuItem" Header="High-Resolution Mode (640x480)"
                          ToggleType="CheckBox" Click="OnHighResChanged"
                          ToolTip.Tip="Enable the opt-in 640x480 CEL/VDLP mode. Only use it for supported titles." />
            </MenuItem>

            <MenuItem Header="View" ToolTip.Tip="Switch the library layout, toggle the log dock, or go fullscreen.">
                <MenuItem Header="Game List" Click="OnShowLibrary"
                          ToolTip.Tip="Return to the game library." />
                <Separator />
                <MenuItem x:Name="GridModeMenuItem" Header="Grid Mode" ToggleType="CheckBox"
                          IsChecked="True" Click="OnGridView"
                          ToolTip.Tip="Show games as cover-art cards." />
                <MenuItem x:Name="ListModeMenuItem" Header="List Mode" ToggleType="CheckBox"
                          Click="OnListView"
                          ToolTip.Tip="Show games as a compact list." />
                <Separator />
                <MenuItem x:Name="ShowLogMenuItem" Header="Show Log" ToggleType="CheckBox"
                          Click="OnToggleLog"
                          ToolTip.Tip="Show or hide the log dock at the bottom of the window." />
                <MenuItem Header="Log Viewer..." Click="OnLogs"
                          ToolTip.Tip="Open the full diagnostic log viewer with filters." />
                <Separator />
                <MenuItem Header="Fullscreen" Click="OnFullscreen"
                          ToolTip.Tip="Toggle fullscreen presentation." />
            </MenuItem>

            <MenuItem Header="Help" ToolTip.Tip="Open the welcome guide or application information.">
                <MenuItem Header="Welcome..." Click="OnWelcome"
                          ToolTip.Tip="Open the first-run guide for BIOS and disc setup." />
                <MenuItem Header="About 5DO" Click="OnAbout"
                          ToolTip.Tip="Show version, renderer, audio, and license information." />
                <Separator />
                <MenuItem Header="Donation Status..." Click="OnDonationStatus"
                          ToolTip.Tip="Enter the email used for a donation and check whether it was recognized." />
                <MenuItem Header="Support 5DO..." Click="OnDonate"
                          ToolTip.Tip="Open the 5DO donation page on purelogiccode.com." />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" x:Name="ToolbarBorder" Padding="10,5"
                Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="toolbar" Click="OnOpenDiscAsync" ToolTip.Tip="Boot a disc image">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconOpen}" />
                            <TextBlock Text="Open" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnOpenBiosAsync" ToolTip.Tip="Open a 3DO BIOS ROM">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconBios}" />
                            <TextBlock Text="BIOS" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnRefresh" ToolTip.Tip="Refresh the game list">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconRefresh}" />
                            <TextBlock Text="Refresh" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="7,6" Background="{DynamicResource BorderBrush}" />

                    <Button Classes="toolbar" Click="OnFullscreen" ToolTip.Tip="Toggle fullscreen">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconFullscreen}" />
                            <TextBlock Text="FullScr" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Classes="toolbar" Click="OnStop"
                            ToolTip.Tip="Stop emulation and return to the game list">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconStop}" />
                            <TextBlock Text="Stop" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayPauseButton" Classes="toolbar" Click="OnPlayPause"
                            ToolTip.Tip="Start emulation">
                        <StackPanel Spacing="2">
                            <PathIcon x:Name="PlayPauseIcon" Width="22" Height="22"
                                      HorizontalAlignment="Center" Data="{StaticResource IconPlay}" />
                            <TextBlock x:Name="PlayPauseText" Text="Start" FontSize="10.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="7,6" Background="{DynamicResource BorderBrush}" />

                    <Button Classes="toolbar" Click="OnSettingsAsync" ToolTip.Tip="Configure the emulator">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconSettings}" />
                            <TextBlock Text="Config" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnInputBindingsAsync" ToolTip.Tip="Configure keyboard and gamepad input">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconGamepad}" />
                            <TextBlock Text="Pads" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="7,6" Background="{DynamicResource BorderBrush}" />

                    <Button Classes="toolbar" Click="OnSaveState" ToolTip.Tip="Save a state to the current slot">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconSave}" />
                            <TextBlock Text="Save" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnLoadState" ToolTip.Tip="Load the current save slot">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconLoad}" />
                            <TextBlock Text="Load" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnSaveSlotsAsync" ToolTip.Tip="Manage save slots">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconSlots}" />
                            <TextBlock Text="Slots" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogsButton" Classes="toolbar" Click="OnToggleLog" ToolTip.Tip="Show or hide the log dock">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconLogs}" />
                            <TextBlock Text="Logs" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Button x:Name="ListViewButton" Classes="toolbar" Click="OnListView"
                            ToolTip.Tip="Switch the game list to list mode">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconList}" />
                            <TextBlock Text="List" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GridViewButton" Classes="toolbar active" Click="OnGridView"
                            ToolTip.Tip="Switch the game list to grid mode">
                        <StackPanel Spacing="2">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                                      Data="{StaticResource IconGrid}" />
                            <TextBlock Text="Grid" FontSize="10.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game library -->
        <Grid Grid.Row="2" x:Name="LibraryView" RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="14,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Classes="sectionTitle" Text="Game List" />
                        <Border Classes="badge" VerticalAlignment="Center"
                                ToolTip.Tip="Number of games found in the configured folders.">
                            <TextBlock x:Name="LibraryCountText" Text="0 games" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" MaxWidth="420" Margin="24,0" VerticalAlignment="Center">
                        <PathIcon Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="8,0,0,0" IsHitTestVisible="False"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  Data="{StaticResource IconSearch}" />
                        <TextBox x:Name="SearchBox" Classes="search" PlaceholderText="Search games..."
                                 TextChanged="OnSearchChanged"
                                 ToolTip.Tip="Filter the game list by name, game ID, or path." />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Icon size" Classes="caption" VerticalAlignment="Center" />
                        <Slider x:Name="IconSizeSlider" Width="110" Minimum="128" Maximum="240"
                                Value="176" TickFrequency="8" IsSnapToTickEnabled="True"
                                ValueChanged="OnIconSizeChanged" VerticalAlignment="Center"
                                ToolTip.Tip="Adjust the size of game cards in the grid view." />
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox x:Name="GridLibraryList" Grid.Row="1" Classes="library libraryGrid"
                     SelectionChanged="OnGridSelectionChanged"
                     DoubleTapped="OnGridDoubleTapped"
                     KeyDown="OnLibraryKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ToolTip.Tip="Select a game. Double-click or press Enter to boot it.">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItem">
                        <Border Classes="card" Width="{DynamicResource LibraryCardWidth}"
                                ToolTip.Tip="{Binding Tip}">
                            <StackPanel>
                                <Border Classes="coverFrame" Height="{DynamicResource LibraryCardImageHeight}">
                                    <Panel>
                                        <TextBlock Text="5DO" FontSize="26" FontWeight="Bold" Opacity="0.12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Cover}" Stretch="Uniform" />
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                           Margin="2,8,2,3" Height="34" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Format}" Classes="caption" />
                                        <TextBlock Text="{Binding GameIdText}" Classes="caption" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="badge known" IsVisible="{Binding Known}">
                                        <TextBlock Text="4DO DB" />
                                    </Border>
                                    <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsUnknown}">
                                        <TextBlock Text="Unknown" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="ListLibraryList" Grid.Row="1" Classes="library libraryList"
                     IsVisible="False"
                     SelectionChanged="OnListSelectionChanged"
                     DoubleTapped="OnListDoubleTapped"
                     KeyDown="OnLibraryKeyDown"
                     ToolTip.Tip="Select a game. Double-click or press Enter to boot it.">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItem">
                        <Border Classes="card" Padding="4" ToolTip.Tip="{Binding Tip}">
                            <Grid ColumnDefinitions="54,*,80,110,76">
                                <Border Classes="coverFrame" Width="48" Height="48">
                                    <Panel>
                                        <TextBlock Text="5DO" FontSize="9" FontWeight="Bold" Opacity="0.15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Cover}" Stretch="Uniform" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Classes="caption"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Format}" Classes="caption"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding SectorText}" Classes="caption"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,12,0" />
                                <Border Grid.Column="4" Classes="badge known" IsVisible="{Binding Known}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="4DO DB" />
                                </Border>
                                <Border Grid.Column="4" Classes="badge" IsVisible="{Binding IsUnknown}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Unknown" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyLibraryPanel" Grid.Row="1" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="420" Spacing="10"
                        ToolTip.Tip="No games were found. Add a folder that contains disc images.">
                <PathIcon Width="52" Height="52" HorizontalAlignment="Center"
                          Foreground="{DynamicResource TextDimBrush}"
                          Data="{StaticResource IconLibrary}" />
                <TextBlock x:Name="EmptyLibraryTitle" Classes="sectionTitle" Text="No games found"
                           HorizontalAlignment="Center"
                           ToolTip.Tip="The library is empty." />
                <TextBlock x:Name="EmptyLibraryText" Classes="muted" TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Add a folder that contains ISO, BIN, CUE, or CHD images."
                           ToolTip.Tip="Add a folder so the library can discover disc images." />
                <Button Classes="accent" Content="Add Game Folder" Click="OnAddFolderAsync"
                        HorizontalAlignment="Center"
                        ToolTip.Tip="Add a folder that contains ISO, BIN, CUE, or CHD images." />
            </StackPanel>

            <!-- Optional donation strip. It stays inside the library view so gameplay is never covered. -->
            <Border x:Name="DonationBanner" Grid.Row="2" IsVisible="False"
                    Padding="12,6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    ToolTip.Tip="Optional support for 5DO development.">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                              VerticalAlignment="Center" IsHitTestVisible="False"
                              Foreground="{DynamicResource AccentBrush}"
                              Data="{StaticResource IconHeart}" />
                    <TextBlock x:Name="DonationBannerText" Grid.Column="1" Classes="caption"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="5DO is free donationware. If it helps you, please consider supporting development."
                               ToolTip.Tip="5DO is free to use. Donations are optional and support development." />
                    <Button x:Name="DonationStatusButton" Grid.Column="2" Classes="chrome"
                            Content="I already donated" Margin="10,0,0,0"
                            Click="OnDonationStatus"
                            ToolTip.Tip="Enter the email used for your donation and check whether it was recognized." />
                    <Button x:Name="DonateButton" Grid.Column="3" Classes="accent"
                            Content="Donate" Padding="12,4" Margin="6,0,0,0"
                            Click="OnDonate"
                            ToolTip.Tip="Open the 5DO donation page on purelogiccode.com." />
                    <Button Grid.Column="4" Classes="chrome" Padding="5,4" Margin="4,0,0,0"
                            Click="OnDismissDonationBanner"
                            ToolTip.Tip="Hide this banner until the next launch.">
                        <PathIcon Width="11" Height="11" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Emulation view (shown while a game is booted) -->
        <Grid Grid.Row="2" x:Name="EmulationView" RowDefinitions="Auto,*"
              IsVisible="False" Background="Black">
            <Border Grid.Row="0" x:Name="EmulationHeader" Padding="8,5"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="chrome" Click="OnShowLibrary"
                            ToolTip.Tip="Return to the game list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="{StaticResource IconLibrary}" />
                            <TextBlock Text="Game List" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="EmulationTitleText" Text="No disc loaded"
                                   FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="The game currently booted in the emulation view." />
                        <TextBlock x:Name="EmulationSubtitleText" Classes="caption"
                                   HorizontalAlignment="Center" MaxWidth="360"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Disc format, game ID, and compatibility-fix information." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="chrome" Click="OnPlayPause"
                                ToolTip.Tip="Start or pause emulation">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon x:Name="HeaderPlayPauseIcon" Width="13" Height="13"
                                          Data="{StaticResource IconPause}" />
                                <TextBlock x:Name="HeaderPlayPauseText" Text="Pause" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chrome" Click="OnStop" ToolTip.Tip="Stop and return to the game list">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconStop}" />
                                <TextBlock Text="Stop" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="4,3" Background="{DynamicResource BorderBrush}" />

                        <Button Classes="chrome" Click="OnSaveState" ToolTip.Tip="Save state">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconSave}" />
                                <TextBlock Text="Save" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chrome" Click="OnLoadState" ToolTip.Tip="Load state">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconLoad}" />
                                <TextBlock Text="Load" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chrome" Padding="5,4" Click="OnPreviousSlot" ToolTip.Tip="Previous slot">
                            <TextBlock Text="&lt;" FontSize="13" />
                        </Button>
                        <TextBlock x:Name="SlotText" Text="Slot 1/10" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="2,0"
                                   ToolTip.Tip="Current save slot. Use the arrows to change it." />
                        <Button Classes="chrome" Padding="5,4" Click="OnNextSlot" ToolTip.Tip="Next slot">
                            <TextBlock Text="&gt;" FontSize="13" />
                        </Button>
                        <Button Classes="chrome" Click="OnScreenshot" ToolTip.Tip="Save a screenshot">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconScreenshot}" />
                                <TextBlock Text="Shot" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chrome" Padding="6,4" Click="OnFullscreen"
                                ToolTip.Tip="Toggle fullscreen">
                            <PathIcon Width="13" Height="13" Data="{StaticResource IconFullscreen}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ctrl:VideoSurface x:Name="Video" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ToolTip.Tip="Emulated 3DO video output rendered by OpenGL." />
                <Image x:Name="CpuVideo" Stretch="Uniform" IsVisible="False"
                       ToolTip.Tip="CPU fallback frame shown when OpenGL is unavailable." />
                <ctrl:VulkanVideoSurface x:Name="VulkanVideo" HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" IsVisible="False"
                                         ToolTip.Tip="Emulated 3DO video output rendered by Vulkan." />
                <Border x:Name="OverlayPanel" IsVisible="False" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="8" Padding="6,3"
                        Background="#A0000000" CornerRadius="3">
                    <TextBlock x:Name="OverlayText" Foreground="#E0E0E0"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               ToolTip.Tip="Live frame, PC, renderer, and audio diagnostics." />
                </Border>
            </Grid>
        </Grid>

        <!-- Log dock -->
        <Border Grid.Row="3" x:Name="LogPanel" IsVisible="False" Height="180"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Padding="10,3" Background="{DynamicResource SurfaceAltBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Width="12" Height="12" Data="{StaticResource IconLogs}"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Log" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="LogSummaryText" Grid.Column="1" Classes="caption"
                                   Margin="12,0" VerticalAlignment="Center"
                                   ToolTip.Tip="Number of retained log entries." />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Classes="chrome" Content="Clear" Click="OnClearLog"
                                    ToolTip.Tip="Remove every entry from the in-memory log." />
                            <Button Classes="chrome" Content="Log Viewer" Click="OnLogs"
                                    ToolTip.Tip="Open the full log viewer with level, category, and text filters." />
                            <Button Classes="chrome" Padding="6,4" Click="OnToggleLog"
                                    ToolTip.Tip="Hide the log dock">
                                <PathIcon Width="11" Height="11" Data="{StaticResource IconClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="LogList" Grid.Row="1" Classes="log"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ToolTip.Tip="Recent diagnostic messages. Open the Log Viewer for filtering." />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" x:Name="StatusBarBorder" Padding="10,4"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Classes="status"
                           Text="Ready." TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="Current status message." />
                <TextBlock x:Name="StatsText" Grid.Column="2" Classes="status" Margin="12,0"
                           ToolTip.Tip="Frame count, program counter, and cycle counters." />
                <TextBlock x:Name="RendererText" Grid.Column="3" Classes="status" Margin="12,0"
                           ToolTip.Tip="Active graphics renderer and version." />
                <TextBlock x:Name="FpsText" Grid.Column="4" Classes="statusStrong"
                           MinWidth="60" TextAlignment="Right"
                           ToolTip.Tip="Measured and target frame rate." />
            </Grid>
        </Border>
    </Grid>
</Window>
