<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:host="using:FiveDo.Host"
        x:Class="FiveDo.Frontend.Avalonia.Views.GameLibraryWindow"
        Title="Game Library"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddFolderButton" Content="Add Folder" Click="OnAddFolderAsync"
                    ToolTip.Tip="Add a folder that contains ISO, BIN, CUE, or CHD images." />
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh"
                    ToolTip.Tip="Rescan the configured game folders." />
            <Button x:Name="OpenButton" Content="Open Selected" Click="OnOpenSelected"
                    ToolTip.Tip="Boot the selected disc in the main window." />
            <Button x:Name="VerifyHealthButton" Content="Verify Health" Click="OnVerifyHealthAsync"
                    ToolTip.Tip="Read every disc and check it against the configured Redump/No-Intro DAT." />
            <Button x:Name="ChooseDatButton" Content="DAT..." Click="OnChooseDatAsync"
                    ToolTip.Tip="Choose the Redump/No-Intro DAT used for the known-dump badge." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,260" Margin="0,8">
            <ListBox x:Name="LibraryList" Grid.Column="0" DoubleTapped="OnDoubleTapped"
                     SelectionChanged="OnSelectionChanged"
                     ToolTip.Tip="Select a disc. Double-click to boot it.">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="host:GameLibraryEntry">
                        <Grid ColumnDefinitions="Auto,2*,Auto,Auto,Auto,Auto,*" Margin="4"
                              ToolTip.Tip="{Binding DetailText}">
                            <Button Classes="favorite small" Grid.Column="0" Content="{Binding FavoriteGlyph}"
                                    Tag="{Binding Path}" Click="OnToggleFavorite" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Add or remove this game from favorites." />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           ToolTip.Tip="Game name from the disc or database." />
                                <TextBlock Text="{Binding MetadataText}" Classes="caption"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="Release year, publisher, developer, genre, and region." />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasDumpBadge}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding DumpTip}">
                                <TextBlock Text="{Binding DumpBadge}" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Format}" Margin="10,0" Opacity="0.8"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Disc image format." />
                            <TextBlock Grid.Column="4" Text="{Binding SectorCount}" Margin="0,0,10,0" Opacity="0.8"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Number of 2048-byte sectors on the data track." />
                            <TextBlock Grid.Column="5" Text="{Binding PlaytimeText}" Margin="0,0,10,0" Opacity="0.8"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Accumulated play time." />
                            <TextBlock Grid.Column="6" Text="{Binding Path}" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="Full path to the disc image." />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Margin="10,0,0,0" Padding="10"
                    Background="#1A1A1A" CornerRadius="4">
                <StackPanel>
                    <Image x:Name="CoverImage" Width="240" Height="320" Stretch="Uniform"
                           ToolTip.Tip="Cover art discovered beside the selected disc image." />
                    <TextBlock x:Name="CoverText" Text="Select a disc to see its cover."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,8,0,0"
                               ToolTip.Tip="Cover-art status for the selected disc." />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="No game folders configured."
                   Foreground="#CCCCCC" TextWrapping="Wrap"
                   ToolTip.Tip="Library scan status and the number of discovered games." />
    </Grid>
</Window>
