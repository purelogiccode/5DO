<Project>

  <!--
    Emulator hot paths are compiled with JIT optimizations in Debug too. A debug build
    otherwise runs Road Rash at ~40 fps on the reference machine (24.6 ms/frame) versus
    ~4 ms/frame optimized. UI/frontend projects remain unoptimized so XAML and host
    debugging stays predictable. Pass -p:FiveDoOptimizeDebug=false to opt out.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(FiveDoOptimizeDebug)' != 'false'">
    <FiveDoOptimizedDebugProject
      Condition="'$(MSBuildProjectName)' == 'FiveDo.Core'
                 or '$(MSBuildProjectName)' == 'FiveDo.Cpu'
                 or '$(MSBuildProjectName)' == 'FiveDo.Memory'
                 or '$(MSBuildProjectName)' == 'FiveDo.Machine'
                 or '$(MSBuildProjectName)' == 'FiveDo.Madam'
                 or '$(MSBuildProjectName)' == 'FiveDo.Clio'
                 or '$(MSBuildProjectName)' == 'FiveDo.Dsp'
                 or '$(MSBuildProjectName)' == 'FiveDo.Sport'
                 or '$(MSBuildProjectName)' == 'FiveDo.Video'
                 or '$(MSBuildProjectName)' == 'FiveDo.Xbus'
                 or '$(MSBuildProjectName)' == 'FiveDo.Cdrom'
                 or '$(MSBuildProjectName)' == 'FiveDo.Cheats'
                 or '$(MSBuildProjectName)' == 'FiveDo.Host'">true</FiveDoOptimizedDebugProject>
    <Optimize Condition="'$(FiveDoOptimizedDebugProject)' == 'true'">true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>5DO</Product>
    <Company>5DO contributors</Company>
    <Version>1.7.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <FiveDoOpenAlSoftVersion>1.23.1</FiveDoOpenAlSoftVersion>
    <FiveDoOpenAlNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FiveDoOpenAlNativeRid>
    <FiveDoOpenAlNativeRid Condition="'$(FiveDoOpenAlNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</FiveDoOpenAlNativeRid>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <!-- Keep restore lock files RID-agnostic. CI publishes with an explicit -r RID;
         without this, PublishTrimmed adds the host RID to every executable lock file. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateDocumentationFile Condition="$(MSBuildProjectName.Contains('.Tests'))">false</GenerateDocumentationFile>
    <GenerateDocumentationFile Condition="$(MSBuildProjectName.Contains('Benchmarks'))">false</GenerateDocumentationFile>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1707;CA1716</NoWarn>
  </PropertyGroup>

</Project>
